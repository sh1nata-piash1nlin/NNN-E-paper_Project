{{#section 'css'}}
<style>
    .status-badge {
        font-size: 0.9em;
        padding: 0.4em 0.8em;
    }
    .status-published { background-color: #28a745; }
    .status-draft { background-color: #ffc107; }
    .status-rejected { background-color: #dc3545; }
    
    .article-card {
        transition: all 0.3s ease;
    }
    .article-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
</style>
{{/section}}

<div class="container mt-4">
    <h1 class="text-center mb-4">My Articles</h1>

    {{#if empty}}
        <div class="alert alert-info text-center">
            You haven't written any articles yet. 
            <a href="/writer" class="alert-link">Start writing now!</a>
        </div>
    {{else}}
        <!-- Rejected Articles -->
        {{#if groupedArticles.rejected}}
            <div class="card mb-4">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Rejected Articles</h4>
                </div>
                <div class="card-body">
                    {{#each groupedArticles.rejected}}
                        <div class="article-card card mb-3">
                            <div class="card-body">
                                <h5 class="card-title">{{this.title}}</h5>
                                <p class="text-muted mb-2">
                                    <small>Category: {{this.category_name}} | Created: {{this.formatted_date}}</small>
                                </p>
                                {{#if this.feedback}}
                                    <div class="alert alert-warning">
                                        <strong>Editor's Feedback:</strong> {{this.feedback}}
                                    </div>
                                {{/if}}
                                <div class="btn-group">
                                    <a href="/writer/edit/{{this.id}}" class="btn btn-primary btn-sm">
                                        <i class="bi bi-pencil"></i> Edit & Resubmit
                                    </a>
                                    <a href="/writer/articles/{{this.id}}" class="btn btn-secondary btn-sm">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </div>
                            </div>
                        </div>
                    {{/each}}
                </div>
            </div>
        {{/if}}

        <!-- Draft Articles -->
        {{#if groupedArticles.draft}}
            <div class="card mb-4">
                <div class="card-header bg-warning">
                    <h4 class="mb-0">Pending Review</h4>
                </div>
                <div class="card-body">
                    {{#each groupedArticles.draft}}
                        <div class="article-card card mb-3">
                            <div class="card-body">
                                <h5 class="card-title">{{this.title}}</h5>
                                <p class="text-muted mb-2">
                                    <small>Category: {{this.category_name}} | Submitted: {{this.formatted_date}}</small>
                                </p>
                                <div class="btn-group">
                                    <a href="/writer/edit/{{this.id}}" class="btn btn-primary btn-sm">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a href="/writer/articles/{{this.id}}" class="btn btn-secondary btn-sm">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </div>
                            </div>
                        </div>
                    {{/each}}
                </div>
            </div>
        {{/if}}

        <!-- Published Articles -->
        {{#if groupedArticles.published}}
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Published Articles</h4>
                </div>
                <div class="card-body">
                    {{#each groupedArticles.published}}
                        <div class="article-card card mb-3">
                            <div class="card-body">
                                <h5 class="card-title">{{this.title}}</h5>
                                <p class="text-muted mb-2">
                                    <small>
                                        Category: {{this.category_name}} | 
                                        Published: {{this.formatted_publish_date}}
                                    </small>
                                </p>
                                <a href="/writer/articles/{{this.id}}" class="btn btn-secondary btn-sm">
                                    <i class="bi bi-eye"></i> View
                                </a>
                            </div>
                        </div>
                    {{/each}}
                </div>
            </div>
        {{/if}}
    {{/if}}
</div>